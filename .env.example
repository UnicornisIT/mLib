# Generate a unique random value of at least 32 characters before starting.
SECRET_KEY=replace-with-a-long-random-secret

# Default Docker setup uses separate SQLite databases in the persistent mlib_data volume.
# DATABASE_URL is retained only for migrating older single-database installations.
DATABASE_URL=sqlite:////data/db/mlib.db
CORE_DATABASE_URL=sqlite:////data/db/core.db
MUSIC_DATABASE_URL=sqlite:////data/db/music.db
MOVIE_DATABASE_URL=sqlite:////data/db/movie.db
BOOKS_DATABASE_URL=sqlite:////data/db/books.db
COLLECTIONS_DATABASE_URL=sqlite:////data/db/collections.db
GAMES_DATABASE_URL=sqlite:////data/db/games.db
WISHES_DATABASE_URL=sqlite:////data/db/wishes.db
ENVIRONMENT=production
SESSION_TTL_HOURS=720
APP_PORT=3000
HTTP_PORT=80
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
MAX_UPLOAD_MB=1024
LOG_LEVEL=INFO

# Optional: TMDB v4 Read Access Token for automatic movie and series cards.
TMDB_API_TOKEN=
MOVIE_METADATA_REFRESH_HOURS=24

# Host directory mounted read-only for folder imports.
MUSIC_IMPORT_PATH=./import

# Used only with docker-compose.postgres.yml.
POSTGRES_USER=mlib
POSTGRES_PASSWORD=replace-with-a-strong-database-password
